fn process(mut input: String) -> String {
    let upper = input.to_uppercase();
    let trimmed = upper.trim().to_string();
    return trimmed;
}
fn contains(mut haystack: String, mut needle: String) -> bool {
    return haystack.contains(&needle);
}
fn split_and_join(mut input: String) -> String {
    let parts = input.split(&String::from(",")).collect::<Vec<_>>();
    return parts.join(&String::from(" - "));
}
