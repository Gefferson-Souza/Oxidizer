fn double_all(mut nums: Vec<f64>) -> Vec<f64> {
    return nums.iter().cloned().map(|n| n * 2f64).collect::<Vec<_>>();
}
fn evens(mut nums: Vec<f64>) -> Vec<f64> {
    return nums
        .clone()
        .into_iter()
        .filter(|n| {
            let n = n.clone();
            n % 2f64 == 0f64
        })
        .collect::<Vec<_>>();
}
fn sum(mut nums: Vec<f64>) -> f64 {
    let mut total = 0f64;
    nums.iter()
        .cloned()
        .for_each(|n| {
            total = total + n;
        });
    return total;
}
