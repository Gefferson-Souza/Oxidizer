expression: rust
---
fn add(mut a: f64, mut b: f64) -> f64 {
    return a + b;
}
fn subtract(mut a: f64, mut b: f64) -> f64 {
    return a - b;
}
fn multiply(mut a: f64, mut b: f64) -> f64 {
    return a * b;
}
fn divide(mut a: f64, mut b: f64) -> f64 {
    return a / b;
}
fn modulo(mut a: f64, mut b: f64) -> f64 {
    return a % b;
}
fn complex(mut x: f64, mut y: f64, mut z: f64) -> f64 {
    return (x + y) * z - x / y;
}
