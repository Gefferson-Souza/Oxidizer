#[derive(Default, Debug, Clone, PartialEq, serde :: Serialize, serde :: Deserialize)]
#[serde(rename_all = "camelCase")]
pub struct User {
    pub name: String,
    pub age: f64,
    pub email: String,
    pub active: bool,
}
#[derive(Default, Debug, Clone, PartialEq, serde :: Serialize, serde :: Deserialize)]
#[serde(rename_all = "camelCase")]
pub struct Product {
    pub id: f64,
    pub title: String,
    pub price: f64,
    pub description: Option<String>,
}
#[derive(Default, Debug, Clone, PartialEq, serde :: Serialize, serde :: Deserialize)]
#[serde(rename_all = "camelCase")]
pub struct ApiResponse {
    pub data: Vec<User>,
    pub total: f64,
    pub success: bool,
}
